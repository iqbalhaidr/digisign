# Log perintah (test/interop/results/ecdsa-p256-sha256/commands.log)

$ openssl.EXE genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out test/interop/results/ecdsa-p256-sha256/openssl.key.pem
exit: 0

$ openssl.EXE pkey -in test/interop/results/ecdsa-p256-sha256/openssl.key.pem -pubout -out test/interop/results/ecdsa-p256-sha256/openssl.pub.pem
exit: 0

$ openssl.EXE pkey -in test/interop/results/ecdsa-p256-sha256/openssl.key.pem -pubout -outform DER -out test/interop/results/ecdsa-p256-sha256/openssl.pub.der
exit: 0

$ openssl.EXE dgst -sha256 -r test/interop/results/ecdsa-p256-sha256/openssl.pub.der
exit: 0
[stdout]
e1c8ba79514d360cc70b7068ea2944e838c166c74e685bd4fdcb93d11f435bbf *test/interop/results/ecdsa-p256-sha256/openssl.pub.der

$ digisign trust add --key test/interop/results/ecdsa-p256-sha256/openssl.pub.pem --package contoh-app --store test/interop/results/ecdsa-p256-sha256/trust.json
exit: 0
[stdout]
keyid:     e1c8ba79514d360cc70b7068ea2944e838c166c74e685bd4fdcb93d11f435bbf
algorithm: ecdsa-p256-sha256
packages:  contoh-app
[stderr]
trust store updated

$ digisign keygen --algorithm ecdsa-p256-sha256 --out test/interop/results/ecdsa-p256-sha256/program
exit: 0
