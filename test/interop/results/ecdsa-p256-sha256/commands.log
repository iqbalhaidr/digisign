public key:  test/interop/results/ecdsa-p256-sha256/program.pub.pem

$ openssl.EXE pkey -in test/interop/results/ecdsa-p256-sha256/program.key.pem -noout
exit: 0

$ openssl.EXE pkey -pubin -in test/interop/results/ecdsa-p256-sha256/program.pub.pem -outform DER -out test/interop/results/ecdsa-p256-sha256/program.pub.der
exit: 0

$ openssl.EXE dgst -sha256 -r test/interop/results/ecdsa-p256-sha256/program.pub.der
exit: 0
[stdout]
58e85df3926f916086b78731114e3bffb9e422507bd619dc8bfc7afead8b45ef *test/interop/results/ecdsa-p256-sha256/program.pub.der

$ digisign sign --file test/scenarios/inputs/contoh-app.bin --package contoh-app --version 1.0.0 --key test/interop/results/ecdsa-p256-sha256/openssl.key.pem --out test/interop/results/ecdsa-p256-sha256/bundle-program.json
exit: 0
[stdout]
