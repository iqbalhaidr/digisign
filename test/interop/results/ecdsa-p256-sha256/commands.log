algorithm: ecdsa-p256-sha256
artifact:  contoh-app.bin (4096 bytes)

$ openssl.EXE dgst -sha256 -verify test/interop/results/ecdsa-p256-sha256/openssl.pub.pem -signature test/interop/results/ecdsa-p256-sha256/sig-program.der test/interop/results/ecdsa-p256-sha256/manifest.bin
exit: 0
[stdout]
Verified OK

$ openssl.EXE dgst -sha256 -sign test/interop/results/ecdsa-p256-sha256/openssl.key.pem -out test/interop/results/ecdsa-p256-sha256/sig-openssl.der test/interop/results/ecdsa-p256-sha256/manifest.bin
exit: 0

# test/interop/results/ecdsa-p256-sha256/bundle-openssl.json: manifest yang sama, tanda tangan dari OpenSSL

$ digisign verify --file test/scenarios/inputs/contoh-app.bin --bundle test/interop/results/ecdsa-p256-sha256/bundle-openssl.json --trust-store test/interop/results/ecdsa-p256-sha256/trust.json --package contoh-app --version 1.0.0 --json
exit: 0
